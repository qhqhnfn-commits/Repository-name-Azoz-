@bot.callback_query_handler(func=lambda call: True)
def callback_query(call):
    user_id = call.from_user.id
    user = get_user(user_id)
    
    if call.data == "buy_views":
        cost = 10
        service = "500 مشاهدة للمنشورات"
    elif call.data == "buy_reactions":
        cost = 15
        service = "50 تفاعل ومشاعر (Reactions)"
    elif call.data == "buy_subscribers":
        cost = 25
        service = "20 مشترك حقيقي"
    else:
        return

    if user["points"] < cost:
        bot.answer_callback_query(call.id, f"❌ نقاطك غير كافية! تحتاج {cost} نقطة.", show_alert=True)
    else:
        user["points"] -= cost
        user["orders"].append(service)
        
        bot.answer_callback_query(call.id, "✅ تم تسجيل طلبك بنجاح!")
        bot.send_message(
            call.message.chat.id, 
            f"✅ **تم إنشاء الطلب بنجاح!**\n\n"
            f"📌 **الخدمة:** {service}\n"
            f"🎯 **القناة Target:** {TARGET_CHANNEL}\n"
            f"📉 **النقاط المتبقية:** {user['points']} نقطة\n\n"
            f"⚡ جاري تنفيذ التفاعل بشكل آمن وآلي خلال دقائق..."
        )

