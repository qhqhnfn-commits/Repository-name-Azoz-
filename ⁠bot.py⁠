@bot.message_handler(func=lambda m: m.text == "🎁 المكافأة اليومية")
def daily_reward(message):
    user_id = message.from_user.id
    user = get_user(user_id)
    current_time = time.time()
    
    if current_time - user["last_claim"] >= 86400:
        user["points"] += 3
        user["last_claim"] = current_time
        bot.send_message(message.chat.id, "🎉 **تم إعطاؤك 3 نقاط مجانية لمكافأتك اليومية!** ارجع بكرة واطلبها مرة ثانية.")
    else:
        remaining = int((86400 - (current_time - user["last_claim"])) / 3600)
        bot.send_message(message.chat.id, f"⏳ لقد أخذت المكافأة اليومية مسبقاً! تعال بعد **{remaining} ساعة**.")

